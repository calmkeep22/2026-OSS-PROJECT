# ══════════════════════════════════════════════════════════════════════════
# 이 저장소는 AI 파트만 담는다.
# 소리 변환·음성 안내·웹 데모는 다른 담당이 맡아 `_local/sound/` 로 뺐다.
#
# 출력 폴더는 `results/` **하나뿐이다.**
# 전에는 parts/ · ai_results/ · outputs/ 세 갈래에 같은 결과가 흩어져
# 같은 그림 61개(6.9MB)가 중복됐다. 셋 다 없앴으므로 여기서도 뺀다.
# ══════════════════════════════════════════════════════════════════════════

# ── 재생성 가능한 것 ─────────────────────────────────────────────────────
# 데이터 캐시. `python cli.py results` 가 다시 만든다. 크고 매일 바뀐다.
# 뉴스 아카이브·패널 캐시·일봉이 전부 여기 있다.
data/

# 로컬 보관용. 옛 노트북(01~06)과 소리 모듈이 여기 있다.
_local/

# 옛 구조의 잔재. 다시 생기면 커밋하지 않는다.
outputs/
parts/
ai_results/

# ── results/ 는 커밋한다 ────────────────────────────────────────────────
# 심사 근거라 그림·표·index.html 을 그대로 올린다.
# 다만 중간 산출물(parquet·npy)은 뺀다 — 크고 재생성된다.
results/**/*.parquet
results/**/*.npy

# ── 학습된 모델과 배포 자산은 커밋한다 ───────────────────────────────────
# 이게 없으면 pip install 만으로는 서비스가 기동되지 않는다.
#
#   registry.parquet       6,228종목 목록          0.2MB   ← 커밋
#   risk_reference.json    위험도 기준분포          0.03MB  ← 커밋
#   pooled_*.pkl           파운데이션 예측 모델     2.7MB   ← 커밋
#   ranker/overseas/news_transfer 등 기존 학습 모델          ← 커밋
#
# refpanel_*.parquet  비교군 종가 패널 (5.6MB) ← 커밋
#
# ⚠️ 이건 요약 통계가 아니라 **시세 파생 데이터**다. 국내 299 · 미국 495종목의
# 6년치 종가 시계열이 그대로 들어 있다(출처: FinanceDataReader / yfinance).
# 그래도 포함하는 이유는 이 저장소가 **오픈소스 공모전 제출물이고 비상업
# 연구·시연 목적**이기 때문이다 — NOTICE.md 가 명시한 "개인·연구용" 범위 안이다.
# 심사자와 팀원이 clone 직후 바로 돌려 볼 수 있어야 해서 넣는다.
#
# 상업적으로 쓰려면 이 파일들을 빼고 각자 받아야 한다:
#     python cli.py reference --build      # 약 20분, 네트워크 필요
#
# 위험도 기준분포(risk_reference.json)는 축별 분위수 101개짜리 격자라
# 진짜 요약 통계다 — 종목도 가격도 복원되지 않는다.
# (TabPFN 가중치는 gated 저장소 소유라 재배포하지 않는다 — NOTICE.md 참조)
models/*.onnx.data
models/tabpfn*

# ── 비밀 ─────────────────────────────────────────────────────────────────
# API 토큰은 **절대** 커밋하지 않는다. 코드는 전부 os.getenv 로만 읽는다.
.env
.env.*
*.key
*token*.txt
secrets.json

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── 모델 캐시 ────────────────────────────────────────────────────────────
.cache/

# ── OS / 에디터 ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/
